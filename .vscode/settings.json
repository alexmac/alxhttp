{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.fontLigatures": "'ss02', 'zero'",
  "editor.wordWrap": "on",
  "debug.toolBarLocation": "commandCenter",
  "coverage-gutters.coverageReportFileName": "output/coverage/index.html",
  "coverage-gutters.coverageBaseDir": "output/coverage",
  "coverage-gutters.coverageFileNames": ["coverage.xml"],
  "ruff.nativeServer": true,
  "html.suggest.html5": true,
  "python.languageServer": "None",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "workspace",
  "cursorpyright.analysis.typeCheckingMode": "basic",
  "cursorpyright.analysis.diagnosticMode": "workspace",
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "Prettier-SQL.commaPosition": "before",
  "Prettier-SQL.denseOperators": false,
  "Prettier-SQL.expressionWidth": 200,
  "Prettier-SQL.indentStyle": "standard",
  "Prettier-SQL.keywordCase": "lower",
  "Prettier-SQL.linesBetweenQueries": 1,
  "Prettier-SQL.logicalOperatorNewline": "before",
  "Prettier-SQL.newlineBeforeSemicolon": false,
  "Prettier-SQL.SQLFlavourOverride": "postgresql",
  "Prettier-SQL.tabulateAlias": true,
  "cSpell.includeRegExpList": ["CStyleComment", "string"],
  "cSpell.ignoreRegExpList": ["from.*"],
}
